<div class="flex items-center gap-1 flex-wrap">
  <a href="<c> ESCAPED(shop_list_query(sv_from_cstr(""), q, 1)); </c>"
    <c> if (cat.count == 0) { </c> class="px-2.5 py-2 text-sm border border-text bg-text text-onbase">
    <c> } else {</c> class="px-2.5 py-2 text-sm border border-surface0 bg-mantle text-subtext0 hover:border-surface1">
    <c> } </c>
    <c> ESCAPED(tr("shop.all", "ទាំងអស់")); </c>
  </a>
  <c> for (size_t ci = 0; ci < chips.count; ++ci) {</c>
    <a href="<c> ESCAPED(shop_list_query(sv_from_cstr(chips.items[ci].id), q, 1)); </c>"
      <c> if (chips.items[ci].on) {</c> class="px-2.5 py-2 text-sm border border-blue bg-blue text-onbase">
      <c> } else {</c> class="px-2.5 py-2 text-sm border border-surface0 bg-mantle text-subtext0 hover:border-surface1">
      <c> } </c>
      <c> ESCAPED(chips.items[ci].name); </c>
    </a>
  <c> } </c>
<c> if (q.count > 0) {</c>
<span class="text-sm text-overlay0 px-1">
  <c> ESCAPED(tr("shop.results_for", "លទ្ធផលសម្រាប់")); </c> "
  <c> ESCAPED(temp_sprintf("%.*s", (int) q.count, q.data)); </c>"
</span>
<c> } </c>
</div>
<c> if (row_count == 0) {</c>
<div class="bg-mantle border border-surface0 text-center px-3 py-8">
  <div class="text-overlay0 text-base">
    <c> ESCAPED(tr("shop.no_products", "មិនមានផលិតផលទេ")); </c>
  </div>
  <a href="/" class="text-sm text-blue hover:underline">
    <c> ESCAPED(tr("shop.clear_filters", "លុបតម្រង")); </c>
  </a>
</div>
<c> } else {</c>
<div class="grid grid-cols-2 md:grid-cols-3 gap-3">
  <c> for (size_t i = 0; i < row_count; ++i) {</c>
  <c> Shop_Row *r = &rows[i]; bool out = r->stock <= 0; </c>
  <div class="bg-mantle border border-surface0 flex flex-col">
  <a href="/product/<c> ESCAPED(r->id); </c>"
     class="bg-blue/10 h-40 flex items-center justify-center text-blue font-bold text-4xl">
  <c> sb_append_first_glyph(&content, r->name); </c>
</a>
<div class="px-2 py-2 flex flex-col gap-1 flex-1">
  <a href="/product/<c> ESCAPED(r->id); </c>"
     class="text-base font-medium text-text hover:text-blue leading-snug">
    <c> ESCAPED(r->name); </c>
  </a>
  <div class="text-sm text-overlay0 truncate">
    <c> ESCAPED(r->sku); </c> · <c> ESCAPED(r->cat); </c>
  </div>
  <div class="text-lg font-semibold text-blue">
    <c> STR(shop_money(r->price)); </c>
  </div>
  <div class="text-sm <c> if (out) {</c>text-red">
    <c> ESCAPED(tr("shop.out_of_stock", "អស់ពីរាក់")); </c>
    <c> } else {</c>text-green">
    <c> ESCAPED(tr("shop.in_stock", "នៅសល់: ")); </c>
    <c> sb_appendf(&content, "%.0f", r->stock); </c>
    <c> } </c>
  </div>
</div>
<form method="POST" action="/cart/add" class="border-t border-surface0 p-1">
  <input type="hidden" name="product_id" value="<c> ESCAPED(r->id); </c>">
  <input type="hidden" name="redirect" value="/">
  <button class="w-full bg-blue text-onbase hover:brightness-90 px-2.5 py-2 text-base disabled:bg-surface0 disabled:text-overlay0"
          <c> if (out) {</c> disabled <c> } </c>>
    <c> ESCAPED(tr("shop.add_to_cart", "ដាក់ក្នុងរទេះ")); </c>
  </button>
</form>
</div>
<c> } </c>
</div>
<c> } </c>
<c> if (pages > 1) {</c>
<div class="flex items-center justify-center gap-2 text-base">
  <c> if (page > 1) {</c>
  <a href="<c> ESCAPED(shop_list_query(cat, q, page - 1)); </c>"
     class="px-2.5 py-2 border border-surface0 bg-mantle text-base">«
  </a>
  <c> } </c>
  <span class="text-overlay0">
