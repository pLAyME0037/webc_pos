<c>
    // Global pager markup (included from every paged list).
    // Scope contract at each include site:
    //   Page_Info page_info;      current window (page_key/per_key/page/per_page/row_start/row_end/total/total_pages)
    //   const char *page_base;    list path, e.g. "/users"
    //   const char *page_container; tbody id the JS swap targets
    //   String_View page_query;   sc->query_string
</c>

<nav class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm"
     data-pg-container="<c> ESCAPED(page_container); </c>"
     data-pg-key="<c> ESCAPED(page_info.page_key); </c>"
     data-pg-per-key="<c> ESCAPED(page_info.per_key); </c>"
     data-pg-base="<c> ESCAPED(page_base); </c>"
     data-pg-per="<c> STR(temp_sprintf("%zu", page_info.per_page)); </c>">
    <span class="text-gray-500 dark:text-gray-400">
        Showing <c> STR(temp_sprintf("%zu", page_info.row_start)); </c>
        &ndash;<c> STR(temp_sprintf("%zu", page_info.row_end)); </c>
        of <c> STR(temp_sprintf("%zu", page_info.total)); </c> rows
    </span>
    <div class="flex items-center gap-1">
        <c> const char *pg_btn = "px-2 py-1 border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"; </c>
        <c> const char *pg_cur = "px-2 py-1 bg-indigo-600 text-white"; </c>
        <c> if (page_info.page > 1) { </c>
        <a class="<c> STR(pg_btn); </c>"
           data-pg-n="<c> STR(temp_sprintf("%zu", page_info.page - 1)); </c>"
           href="<c> page_href(sb, page_base, page_query, &page_info, page_info.page - 1, page_info.per_page); </c>">Prev</a>
        <c> } else { </c>
        <span class="<c> STR(pg_btn); </c> opacity-40">Prev</span>
        <c> } </c>
        <c>
            size_t pg_first = 1;
            if (page_info.page > 3) {
                pg_first = page_info.page - 2;
            }
            if (pg_first + 4 > page_info.total_pages) {
                if (page_info.total_pages > 4) {
                    pg_first = page_info.total_pages - 4;
                } else {
                    pg_first = 1;
                }
            }
            size_t pg_last = pg_first + 4;
            if (pg_last > page_info.total_pages) {
                pg_last = page_info.total_pages;
            }
        </c>
        <c> if (pg_first > 1) { </c>
        <a class="<c> STR(pg_btn); </c>" data-pg-n="1"
           href="<c> page_href(sb, page_base, page_query, &page_info, 1, page_info.per_page); </c>">1</a>
        <span class="text-gray-400 px-1">&hellip;</span>
        <c> } </c>
        <c> for (size_t pgn = pg_first; pgn <= pg_last; ++pgn) { </c>
            <c> if (pgn == page_info.page) { </c>
            <span class="<c> STR(pg_cur); </c>"><c> STR(temp_sprintf("%zu", pgn)); </c></span>
            <c> } else { </c>
            <a class="<c> STR(pg_btn); </c>"
               data-pg-n="<c> STR(temp_sprintf("%zu", pgn)); </c>"
               href="<c> page_href(sb, page_base, page_query, &page_info, pgn, page_info.per_page); </c>"><c> STR(temp_sprintf("%zu", pgn)); </c></a>
            <c> } </c>
        <c> } </c>
        <c> if (pg_last < page_info.total_pages) { </c>
        <span class="text-gray-400 px-1">&hellip;</span>
        <a class="<c> STR(pg_btn); </c>"
           data-pg-n="<c> STR(temp_sprintf("%zu", page_info.total_pages)); </c>"
           href="<c> page_href(sb, page_base, page_query, &page_info, page_info.total_pages, page_info.per_page); </c>"><c> STR(temp_sprintf("%zu", page_info.total_pages)); </c></a>
        <c> } </c>
        <c> if (page_info.page < page_info.total_pages) { </c>
        <a class="<c> STR(pg_btn); </c>"
           data-pg-n="<c> STR(temp_sprintf("%zu", page_info.page + 1)); </c>"
           href="<c> page_href(sb, page_base, page_query, &page_info, page_info.page + 1, page_info.per_page); </c>">Next</a>
        <c> } else { </c>
        <span class="<c> STR(pg_btn); </c> opacity-40">Next</span>
        <c> } </c>
        <span class="text-gray-400 px-2">|</span>
        <span class="text-gray-500 dark:text-gray-400">Per page:</span>
        <c>
            static const size_t pp_opts[] = { 10, 20, 50 };
            bool pp_is_preset = false;
            for (size_t ppi = 0; ppi < 3; ++ppi) {
                size_t ppv = pp_opts[ppi];
                if (ppv == page_info.per_page) {
                    pp_is_preset = true;
        </c>
            <span class="<c> STR(pg_cur); </c>"><c> STR(temp_sprintf("%zu", ppv)); </c></span>
            <c> } else { </c>
            <a class="<c> STR(pg_btn); </c>"
               href="<c> page_href(sb, page_base, page_query, &page_info, 1, ppv); </c>"><c> STR(temp_sprintf("%zu", ppv)); </c></a>
            <c> } </c>
        <c> } </c>
        <c> if (!pp_is_preset) { </c>
            <span class="<c> STR(pg_cur); </c>"><c> STR(temp_sprintf("%zu", page_info.per_page)); </c></span>
        <c> } </c>
    </div>
</nav>
